{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tenable",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"vars": {
		// Cost guardrails — see circuitBreaker.ts / suggestRateLimit.ts.
		// Raise deliberately if real traffic ever approaches these, don't
		// delete the guardrail.
		"DAILY_REQUEST_BUDGET": 20000,
		"SUGGEST_RATE_LIMIT_PER_MINUTE": 30
	},
	"upload_source_maps": true,
	"assets": {
		"directory": "./dist/client",
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tenable-content",
			"database_id": "a87ef250-cc94-4765-a821-785acbcd71a4"
		}
	],
	"kv_namespaces": [
		{
			"binding": "PROGRESS",
			"id": "f04cfb81bc8e4ba783cd3157d59e2734"
		}
	]
}
