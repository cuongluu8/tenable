{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "top-10-tension",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"vars": {
		// The scrolling ticker banner's manual-override message (see
		// routes/ticker.ts / components/Ticker.tsx) — leave empty (the
		// normal state) and the ticker shows the latest Premier League
		// scores instead (lib/eplTicker.ts, kept fresh by the */15 cron
		// below). Set this to something and redeploy (or override it for
		// the live Worker without a redeploy via the Cloudflare dashboard,
		// Workers & Pages → this Worker → Settings → Variables) for a
		// one-off announcement — a birthday shout-out, etc. — which always
		// wins over the scores while it's set. A dashboard override is
		// reset back to this value the next time `wrangler deploy` runs.
		"TICKER_MESSAGE": "",
		// Kill switch for the remote multiplayer feature (in progress,
		// 2026-09-13) — same override pattern as TICKER_MESSAGE: leave
		// true normally, flip to false via the Cloudflare dashboard
		// (Workers & Pages → this Worker → Settings → Variables) for an
		// instant, no-redeploy way to hide the feature and reject new
		// sessions if something's wrong in production, without touching
		// anything already in progress (an existing session is left to
		// finish rather than hard-cut).
		"REMOTE_MULTIPLAYER_ENABLED": true,
		// remoteGameSession.ts's own ROUND_START_GRACE_MS -- how long after a
		// round starts guesses are rejected, closing the poll-timing head
		// start described there. A real, tunable var (not a bare constant)
		// so integration tests
		// override this to 0 (vitest.integration.config.ts) so they don't
		// need a real multi-second sleep between starting a round and
		// guessing on it.
		"ROUND_START_GRACE_MS": 5000,
		// remoteGameSession.ts's own MIN_REVEAL_MS -- the least time a
		// decided round stays on its answer reveal before the ready gate may
		// advance past it, so every device gets a poll in during the reveal.
		// Same tunable-var pattern and test override (to 0) as above.
		"MIN_REVEAL_MS": 5000,
		// remoteGameSession.ts's own IDLE_REMOVE_MS -- how long a player can
		// go unseen (no socket ping, no poll) before they're dropped from
		// the session on the next request. Same tunable-var pattern;
		// integration tests shrink it to a couple of seconds.
		"IDLE_REMOVE_MS": 1800000
	},
	// Cloudflare's Rate Limiting binding -- in-memory at the edge, free-plan
	// compatible, no storage ops. Replaces (2026-09-14) the D1-backed daily
	// request counter and per-IP suggest limiter, each of which cost a
	// contended D1 write on every request -- see docs/scaling.md and
	// lib/rateLimits.ts. Limits are static here (a change needs a deploy);
	// `period` may only be 10 or 60 seconds. Enforcement is per Cloudflare
	// location and best-effort, which is fine for a per-player abuse guard
	// and a burst backstop, not for accounting.
	"ratelimits": [
		// Per player (token / device): every non-poll, non-image API call. A
		// runaway-client bound (a stuck retry loop does hundreds a second),
		// NOT a human-pace check -- a person peaks at maybe 60/min, and
		// scripts/playtest.ts, which plays all 48 categories on one device
		// in ~4 minutes, runs at ~170/min and must fit under it (it didn't at
		// 120: CI run 34892255975, 2026-09-14).
		{ "name": "PLAYER_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
		// Per player: typeahead keystrokes specifically.
		{ "name": "SUGGEST_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
		// Whole app, one key: a per-location burst ceiling standing in for the
		// old daily budget as the "runaway cost" guard on a paid plan.
		{ "name": "GLOBAL_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 3000, "period": 60 } },
		// Per connecting IP: remote-play session create + join together (the
		// two routes reachable with no identity -- see lib/rateLimits.ts's
		// enforceSessionRateLimit). Generous on purpose: a 100-person venue
		// on one Wi-Fi joining inside a minute is a real case; a script
		// minting sessions is what this bounds. scripts/loadtest.ts ramps
		// its rooms under this from one machine.
		{ "name": "SESSION_RATE_LIMITER", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } }
	],
	"upload_source_maps": true,
	"triggers": {
		// Two schedules, told apart by event.cron in index.ts's scheduled():
		// - "0 3 * * *": nightly rebuild of category_answers from
		//   entity_stats (see src/worker/lib/rebuild.ts). 03:00 UTC is
		//   off-peak for this app's (currently nonexistent) traffic; revisit
		//   only if that changes.
		// - "*/15 * * * *": refresh the ticker's Premier League scores (see
		//   src/worker/lib/eplTicker.ts) -- frequent enough that a live
		//   match's score doesn't sit stale for long, nowhere near
		//   football-data.org's free-tier rate limit (10 req/min) or this
		//   Worker's own request budget (96 runs/day either way).
		// Cron Triggers run in this same Worker on the Free plan for both --
		// no external scheduler, no new billable resource.
		"crons": ["0 3 * * *", "*/15 * * * *"]
	},
	"assets": {
		"directory": "./dist/client",
		"not_found_handling": "single-page-application",
		// Without this, Cloudflare's asset routing uses automatic
		// Sec-Fetch-Mode:navigate detection: ANY real browser navigation
		// (address bar, a link, a hard refresh) gets served the SPA's
		// index.html regardless of path -- including /api/* -- since a
		// browser navigating to a URL sends that header and curl/fetch/XHR
		// don't. This silently broke /api/admin/media-audit (a route meant
		// to be visited directly) in both local dev and production; curl
		// "confirming" it worked was a false positive precisely because
		// curl never sends that header. run_worker_first forces matching
		// paths to always hit the Worker, navigation or not. Needs Wrangler
		// 4.20.0+ / Cloudflare Vite plugin 1.7.0+ (both satisfied here).
		"run_worker_first": ["/api/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tenable-content",
			"database_id": "a87ef250-cc94-4765-a821-785acbcd71a4"
		}
	],
	"kv_namespaces": [
		{
			"binding": "PROGRESS",
			"id": "f04cfb81bc8e4ba783cd3157d59e2734"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "tenable-media",
			// Real badge/flag uploads only ever go to the production bucket
			// (see data/research/upload_media.sh) -- local R2 emulation is
			// always empty, so without this every image shows as broken in
			// local dev regardless of what's actually uploaded. D1 stays
			// local (no "remote" flag on d1_databases above) so local dev
			// still doesn't touch the D1 free-tier quota at all -- this only
			// affects the MEDIA binding.
			"remote": true
		}
	],
	"durable_objects": {
		"bindings": [
			{
				// One instance per remote multiplayer game session (see
				// src/worker/durableObjects/remoteGameSession.ts's own doc for
				// why a Durable Object rather than D1 alone). SQLite-backed
				// (see the migration below), the only backend available on the
				// Workers Free plan and the one Cloudflare recommends for any
				// new class regardless of plan.
				"name": "REMOTE_GAME_SESSION",
				"class_name": "RemoteGameSession"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["RemoteGameSession"]
		}
	]
	,
	// Staging (2026-09-15): a second Worker, `top-10-tension-staging`, for
	// scripts/loadtest.ts to hammer without touching real players'
	// sessions. Deliberately SHARES the production D1, KV and R2 bindings
	// -- remote play reads D1 (grading, question assembly) and writes
	// nothing to it, the daily game's KV isn't exercised by the load test,
	// and images are read-only -- so deploying it creates no new storage,
	// only the Worker itself. What it does NOT share is what matters for a
	// load test: its own Durable Object namespace (every session object),
	// its own rate-limit buckets, its own logs. No cron triggers: the
	// nightly rebuild and the ticker refresh must run exactly once, from
	// production. Deploy with `npm run deploy:staging`; remove with
	// `wrangler delete --name top-10-tension-staging`.
	//
	// HOW `wrangler deploy` PICKS AN ENV HERE: the Cloudflare Vite plugin
	// writes a RESOLVED config to dist/top_10_tension/wrangler.json (one
	// environment, no `env` block) and a redirect in .wrangler/deploy/ that
	// `wrangler deploy` follows -- so `wrangler deploy --env staging` on
	// its own does NOT pick this block up (confirmed 2026-09-15: the dry
	// run resolved to whatever the LAST build was). The environment is
	// chosen at BUILD time: `CLOUDFLARE_ENV=staging vite build`, which is
	// what `npm run deploy:staging` does; `npm run deploy` rebuilds for
	// production first for the same reason. Workers Builds (the auto
	// deploy on push) runs its own production build.
	"env": {
		"staging": {
			"name": "top-10-tension-staging",
			"vars": {
				"TICKER_MESSAGE": "",
				"REMOTE_MULTIPLAYER_ENABLED": true,
				"ROUND_START_GRACE_MS": 5000,
				"MIN_REVEAL_MS": 5000,
				"IDLE_REMOVE_MS": 1800000
			},
			"ratelimits": [
				{ "name": "PLAYER_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
				{ "name": "SUGGEST_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
				{ "name": "GLOBAL_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 3000, "period": 60 } },
				{ "name": "SESSION_RATE_LIMITER", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } }
			],
			"triggers": { "crons": [] },
			"d1_databases": [{ "binding": "DB", "database_name": "tenable-content", "database_id": "a87ef250-cc94-4765-a821-785acbcd71a4" }],
			"kv_namespaces": [{ "binding": "PROGRESS", "id": "f04cfb81bc8e4ba783cd3157d59e2734" }],
			"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "tenable-media" }],
			"durable_objects": { "bindings": [{ "name": "REMOTE_GAME_SESSION", "class_name": "RemoteGameSession" }] },
			"migrations": [{ "tag": "v1", "new_sqlite_classes": ["RemoteGameSession"] }]
		}
	}
}
