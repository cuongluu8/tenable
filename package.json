{
	"name": "top-10-tension",
	"description": "A template for building a React application with Vite, Hono, and Cloudflare Workers",
	"cloudflare": {
		"label": "Vite React Template",
		"products": [
			"Workers"
		],
		"categories": [],
		"preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/532a5378-9717-4964-385b-5fafd2160200/public",
		"preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/ec7f4be5-d1d6-4e94-0851-126341745400/preview",
		"publish": true
	},
	"dependencies": {
		"hono": "4.11.1",
		"react": "19.2.1",
		"react-dom": "19.2.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.52.1",
		"@cloudflare/vitest-plugin": "1.1.8",
		"@cloudflare/workers-types": "5.20260811.1",
		"@eslint/js": "9.39.1",
		"@playwright/test": "1.63.0",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.1",
		"@vitest/coverage-v8": "4.1.11",
		"eslint": "9.39.2",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"globals": "16.5.0",
		"jsdom": "30.0.1",
		"jsonc-parser": "3.3.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.48.0",
		"vite": "^7.0.0",
		"vitest": "4.1.11",
		"wrangler": "4.123.0"
	},
	"private": true,
	"scripts": {
		"build": "tsc -b && vite build",
		"cf-typegen": "wrangler types",
		"check": "tsc && vite build && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "vite",
		"lint": "eslint .",
		"preview": "npm run build && vite preview",
		"verify:matching": "node --experimental-strip-types scripts/verify-guess-matching.ts",
		"verify:category-defs": "node --experimental-strip-types scripts/verify-category-defs.ts",
		"verify:content-source": "node --experimental-strip-types scripts/verify-content-source.ts",
		"verify:club-badges": "node --experimental-strip-types scripts/verify-club-badges.ts",
		"verify:query-plans": "node --experimental-strip-types scripts/verify-query-plans.ts",
		"playtest": "node --experimental-strip-types scripts/playtest.ts",
		"apply:content-refresh": "node --experimental-strip-types scripts/apply-content-refresh.ts",
		"db:seed:regen": "node --experimental-strip-types scripts/regen-seed.ts",
		"db:local:reset": "node --experimental-strip-types scripts/reset-local-d1.ts",
		"test:unit": "vitest run --config vitest.config.ts",
		"test:coverage": "vitest run --config vitest.config.ts --coverage",
		"pretest:integration": "node --experimental-strip-types scripts/gen-test-wrangler-config.ts",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:e2e": "playwright test",
		"verify:all": "npm run test:coverage && npm run test:integration && npm run test:e2e && npm run build"
	},
	"type": "module",
	"allowScripts": {
		"esbuild@0.28.1": true,
		"esbuild@0.28.2": true,
		"workerd@1.20260811.1": true,
		"fsevents@2.3.3": true,
		"workerd@1.20260911.1": true
	}
}
