{
	"name": "tenable",
	"description": "A template for building a React application with Vite, Hono, and Cloudflare Workers",
	"cloudflare": {
		"label": "Vite React Template",
		"products": [
			"Workers"
		],
		"categories": [],
		"preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/532a5378-9717-4964-385b-5fafd2160200/public",
		"preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/ec7f4be5-d1d6-4e94-0851-126341745400/preview",
		"publish": true
	},
	"dependencies": {
		"csv-parse": "^5.6.0",
		"hono": "^4.13.5",
		"node-fetch": "^3.3.2",
		"react": "19.2.1",
		"react-dom": "19.2.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.52.1",
		"@eslint/js": "9.39.1",
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.1",
		"eslint": "9.39.2",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"globals": "16.5.0",
		"husky": "^9.1.7",
		"ts-node": "^10.9.2",
		"typescript": "5.9.3",
		"typescript-eslint": "8.48.0",
		"vite": "^7.0.0",
		"wrangler": "4.123.0"
	},
	"private": true,
	"scripts": {
		"type-check": "tsc --noEmit",
		"cf-typegen": "wrangler types",
		"check": "tsc && vite build && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "vite",
		"lint": "eslint . && npm run type-check",
		"preview": "npm run build && vite preview",
		"verify:matching": "node --experimental-strip-types scripts/verify-guess-matching.ts",
		"verify:category-defs": "node --experimental-strip-types scripts/verify-category-defs.ts",
		"verify:content-source": "node --experimental-strip-types scripts/verify-content-source.ts",
		"playtest": "node --experimental-strip-types scripts/playtest.ts",
		"prepare": "husky install"
	},
	"type": "module",
	"allowScripts": {
		"esbuild@0.28.2": true,
		"esbuild@0.28.1": true,
		"fsevents@2.3.3": true,
		"workerd@1.20260811.1": true
	}
}
