{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
		"target": "ES2022",
		"lib": ["ES2023"],
		"module": "ESNext",
		"skipLibCheck": true,

		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"noEmit": true,
		"resolveJsonModule": true,

		/* Linting */
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true,

		// @cloudflare/workers-types (NOT ./worker-configuration.d.ts --
		// see test/integration/env.d.ts's own doc for why) provides
		// D1Database/KVNamespace/R2Bucket etc.; vite/client declares the
		// `*.sql?raw` import suffix setup.ts uses to inline schema.sql/
		// fixtures as strings; @cloudflare/vitest-plugin/types declares
		// `cloudflare:test`'s env/SELF, typed against Cloudflare.Env --
		// which test/integration/env.d.ts (picked up by this project's own
		// "test/**/*.ts" include below, since a .d.ts file still matches
		// *.ts) declares directly.
		"types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types", "vite/client"]
	},
	// Deliberately test/** and the root test-tool configs ONLY -- NOT
	// src/**/*.test.ts. A co-located unit test for e.g. src/worker/lib/
	// eplTicker.ts naturally belongs to tsconfig.worker.json's own project
	// instead (it needs that project's exact settings), same "one file,
	// one owning project" reasoning as env.d.ts's doc above.
	"include": ["test/**/*.ts", "vitest.config.ts", "vitest.integration.config.ts", "playwright.config.ts"]
}
